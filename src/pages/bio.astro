---
import PageLayout from '../layouts/PageLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import Table from '../components/Table.astro';
import Figure from '../components/Figure.astro';
import ExternalLink from '../components/ExternalLink.astro';
import motto from '../assets/motto.jpg';
import { SITE_METADATA } from '../data/site-metadata';
import { STRUCTURED_DATA } from '../data/structured-data';
import { buildCapabilities } from '../data/capabilities';
import { createPageSchema } from '../lib/page-metadata';
import type { PageMetadata } from '../types';

const PAGE_METADATA: PageMetadata = {
  title: 'About',
  description:
    'Dawid Ryłko, Solution Architect with over 10 years in IT. Career history, education, areas of work, and a CV in PDF.',
  keywords: [
    'Dawid Ryłko',
    'Solution Architect',
    'system architecture',
    'cybersecurity',
    'full-stack developer',
    'AI agents',
    'engineering leadership',
    'mobile development',
    'curriculum vitae',
  ],
};

const experience: [string, string, string, string?][] = [
  ['Silesian Solutions', 'Self-employed', 'Oct 2015 - Present', 'https://silesiansolutions.com'],
  ['Cyber Katalog', 'Project Lead', 'Mar 2025 - Present', 'https://cyberkatalog.pl'],
  ['Proget', 'Project Architect', 'May 2026 - Present', 'https://proget.pl'],
  ['Proget', 'Team Leader, Senior Frontend Developer', 'Oct 2017 - Apr 2026', 'https://proget.pl'],
  ['Actaware', 'Lead Mobile Developer', 'Mar 2022 - May 2024', 'https://actaware.com'],
  ['DaVinci Studio', 'Frontend Developer', 'Dec 2015 - Sep 2017', 'https://www.davinci-studio.com'],
  ['Wholesaler (local company)', 'IT Specialist - Programmer', 'Aug 2013 - Oct 2015'],
];

const education: string[][] = [
  [
    'University of Bielsko-Biala',
    'Master of Science in Engineering (MSc Eng)',
    'Computer Science - Information and Communication Technologies',
  ],
  [
    'The Silesian University of Technology',
    'Bachelor of Engineering (BEng)',
    'Computer Science - Internet and Computer Systems',
  ],
];

const citations = [
  {
    authorName: 'Andrzej Stasiuk',
    citation: 'Jadąc do Babadag',
    text: 'Wszystko trzeba wymyślać od nowa, ponieważ dni nie mogą przepadać w przeszłości, wypełnione jedynie pejzażem, nieruchomą, niezmienną materią, która w końcu strząśnie nas ze swojego cielska, strzepnie jak te wszystkie drobne incydenty, te twarze oraz istnienia nie dłuższe niż jedno spojrzenie.',
    extraDetails: [] as { type: string; note: string }[],
  },
  {
    authorName: 'Andrzej Stasiuk',
    citation: 'On the Road to Babadag',
    text: 'Everything must be invented anew, because days cannot vanish into the past filled merely with landscape, with motionless, unchanging matter, which will finally shake us off its body, flick us away like all those minor incidents, those faces and existences lasting no longer than a single glance.',
    extraDetails: [{ type: 'translation', note: 'Translated by ChatGPT.' }],
  },
];

// About framing of the shared capability areas: where the experience comes from,
// written from a track-record angle rather than the home page's tagline style.
const capabilities = buildCapabilities({
  'System architecture':
    'Designing module architecture, defining the standards around it, and reviewing implementations against the agreed design.',
  Cybersecurity:
    'A long-standing focus that shapes how I review and harden what I build, and the reason Cyber Katalog exists.',
  'Full-stack engineering':
    'A decade of React, Angular, and TypeScript frontends on Node.js APIs, plus mobile releases on the App Store and Google Play.',
  'Infrastructure and delivery':
    'Building the CI/CD and automation around the systems I design, and running the production environments that follow.',
  'AI agents and automation':
    'Putting LLMs and agent workflows into everyday engineering work, and keeping them running afterwards.',
  'Engineering leadership':
    'Years of leading and mentoring engineers, owning a product end to end, and setting technical direction as teams grow.',
});

const image = {
  alt: `Graffiti on a utility box featuring a black-and-white image of Charlie Chaplin with the quote: 'A day without laughter is a day wasted'.`,
  figcaption: `Photo by Dawid Ryłko, taken on September 7, 2017, in Malia, Greece.`,
};

const { personReference } = STRUCTURED_DATA;

const structuredData = createPageSchema({
  pathname: Astro.url.pathname,
  // ProfilePage is schema.org's type for an about/profile page; pairing it with
  // mainEntity = the Person it describes is Google's recommended pattern and
  // keeps the page node consistent with the site-wide #person node.
  type: 'ProfilePage',
  title: PAGE_METADATA.title,
  description: PAGE_METADATA.description,
  keywords: PAGE_METADATA.keywords,
  extra: {
    about: {
      '@type': 'CreativeWork',
      name: 'Favourite Quote',
      description: 'Quotes that shape how Dawid Ryłko thinks about technology and craft.',
      citation: citations.map(({ authorName, citation, text }) => ({
        '@type': 'Quotation',
        text,
        author: { '@type': 'Person', name: authorName },
        citation,
      })),
    },
    mainEntity: personReference,
    potentialAction: {
      '@type': 'DownloadAction',
      name: 'Download my CV',
      description: "Download Dawid Ryłko's full CV in PDF, in English or Polish.",
      object: { '@type': 'DigitalDocument', name: 'Dawid Ryłko CV' },
      target: [
        {
          '@type': 'EntryPoint',
          urlTemplate: `${SITE_METADATA.url}/resume-en.pdf`,
          actionPlatform: 'https://schema.org/DesktopWebPlatform',
        },
        {
          '@type': 'EntryPoint',
          urlTemplate: `${SITE_METADATA.url}/resume-pl.pdf`,
          actionPlatform: 'https://schema.org/DesktopWebPlatform',
        },
      ],
    },
  },
});
---

<PageLayout breadcrumbTitle={PAGE_METADATA.title} title={PAGE_METADATA.title} description={PAGE_METADATA.description}>
  <JsonLd data={structuredData} />
  <header>
    <h1>{PAGE_METADATA.title}</h1>
  </header>
  <section id="summary">
    <p>
      I'm <strong>Dawid Ryłko</strong>. I design system architecture and own its security. Over ten years in IT, spent
      across the whole stack: frontend interfaces, backend services, infrastructure automation, AI integration, and
      cybersecurity.
    </p>
    <p>
      <ExternalLink href="https://silesiansolutions.com/" follow>Silesian Solutions</ExternalLink> is my own business, and{
        ' '
      }
      <ExternalLink href="https://cyberkatalog.pl/">Cyber Katalog</ExternalLink> is a cybersecurity project under it. Technical
      decisions get weighed against business goals and the cost of running a system for years. That second cost is the one
      estimates usually skip.
    </p>
    <p>
      My code is on <ExternalLink href="https://github.com/dawidrylko">GitHub</ExternalLink>, shorter notes on{' '}
      <ExternalLink href="https://www.linkedin.com/in/dawidrylko">LinkedIn</ExternalLink> and{' '}
      <ExternalLink href="https://twitter.com/dawidrylko">Twitter</ExternalLink>.{' '}
      <ExternalLink href="https://dawid.dev" follow>dawid.dev</ExternalLink> holds the rest: engineering notes, and longer
      write-ups on security.
    </p>
  </section>
  <section id="what-i-do">
    <h2>What I do</h2>
    <ul class="capabilities">
      {
        capabilities.map(({ term, description }) => (
          <li>
            <strong>{term}</strong>
            {description}
          </li>
        ))
      }
    </ul>
  </section>
  <section id="philosophy">
    <h2>Philosophy</h2>
    <p>
      Engineering is a craft, and craft is mostly judgement. The quote and the photo below say that better than a list
      of principles would.
    </p>
  </section>
  <section id="quote">
    {
      citations.map(({ authorName, citation, text, extraDetails }) => (
        <blockquote>
          {text}
          <br />
          <cite>
            - {authorName}, {citation}
          </cite>
          {extraDetails.map(({ note }) => (
            <>
              <br />
              <small>{note}</small>
            </>
          ))}
        </blockquote>
      ))
    }
  </section>
  <Figure src={motto} alt={image.alt} caption={image.figcaption} />
  <section id="experience">
    <h2>Experience</h2>
    <Table
      data={experience.map(([company, position, duration]) => [company, position, duration])}
      header={['Company', 'Position', 'Duration']}
      widthConfig={['35%', '35%', '30%']}
      ariaLabel="Professional experience"
    />
  </section>
  <section id="education">
    <h2>Education</h2>
    <Table
      data={education}
      header={['Institution', 'Degree', 'Field of study']}
      widthConfig={['35%', '35%', '30%']}
      ariaLabel="Education"
    />
  </section>
  <section id="download">
    <h2>Download my CV</h2>
    <p>The full CV, with dates, roles, and the technology behind each of them. English and Polish, both PDF.</p>
    <ul>
      <li>
        <a href="/resume-en.pdf" download="Dawid_Rylko_CV_EN.pdf" title="Download Full CV (English)">
          Download CV (English PDF) 🇬🇧
        </a>
      </li>
      <li>
        <a href="/resume-pl.pdf" download="Dawid_Rylko_CV_PL.pdf" title="Download Full CV (Polish)">
          Download CV (Polish PDF) 🇵🇱
        </a>
      </li>
    </ul>
  </section>
  <section id="contact">
    <h2>Get in touch</h2>
    <p>
      Interested in working together, or have a question?{' '}
      <a href="/contact/" title="Contact Dawid Ryłko">Visit my contact page</a> or{' '}
      <a href={`mailto:${SITE_METADATA.author.email}`} title="Send me an email">send me an email</a>. Email is the
      fastest route.
    </p>
  </section>
</PageLayout>
