---
import PageLayout from '../layouts/PageLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import ExternalLink from '../components/ExternalLink.astro';
import { SITE_METADATA } from '../data/site-metadata';
import { STRUCTURED_DATA } from '../data/structured-data';
import { buildCapabilities } from '../data/capabilities';
import { createPageSchema } from '../lib/page-metadata';
import type { PageMetadata } from '../types';

const PAGE_METADATA: PageMetadata = {
  title: 'Contact',
  description:
    'Get in touch with Dawid Ryłko about system architecture, security reviews, full-stack delivery, and technical leadership.',
  keywords: [
    'contact Dawid Ryłko',
    'system architecture consulting',
    'cybersecurity consulting',
    'security review',
    'full-stack development',
    'cloud infrastructure',
    'AI agents',
    'technology collaboration',
  ],
};

const author = SITE_METADATA.author;
const social = SITE_METADATA.social;
const { personReference } = STRUCTURED_DATA;

// Contact framing of the shared capability areas: short, engagement-oriented
// lines describing what we can work on together, distinct from the home/about copy.
const capabilities = buildCapabilities({
  'System architecture': 'Designing a system, or reviewing an architecture that has stopped scaling.',
  Cybersecurity: 'A security review, threat model, or hardening pass on something already running.',
  'Full-stack engineering': 'Building or scaling a TypeScript product, web or mobile.',
  'Infrastructure and delivery': 'Shaping CI/CD, containers, and cloud so releases stop being events.',
  'AI agents and automation': 'Adding LLM or agent-driven automation to work your team does by hand today.',
  'Engineering leadership': 'Leading an engineering team, or providing senior technical direction.',
});

const structuredData = createPageSchema({
  pathname: Astro.url.pathname,
  title: PAGE_METADATA.title,
  description: PAGE_METADATA.description,
  keywords: PAGE_METADATA.keywords,
  extra: { mainEntity: personReference },
});
---

<PageLayout breadcrumbTitle={PAGE_METADATA.title} title={PAGE_METADATA.title} description={PAGE_METADATA.description}>
  <JsonLd data={structuredData} />
  <header>
    <h1>{PAGE_METADATA.title}</h1>
  </header>
  <section>
    <p>
      I take on work where the architecture matters and the system has to keep running long after the launch. A
      greenfield project is fine. So is a platform that has grown past its original design.
    </p>
    <p>Tell me what the problem is and what you have already tried. That is enough to start.</p>
  </section>
  <section id="what-i-do">
    <h2>What we can work on</h2>
    <ul class="capabilities">
      {
        capabilities.map(({ term, description }) => (
          <li>
            <strong>{term}</strong>
            {description}
          </li>
        ))
      }
    </ul>
  </section>
  <section>
    <h2>How to reach me</h2>
    <p>
      The best way to get in touch is by email:&nbsp;
      <a href={`mailto:${author.email}`} title="Send email"><strong>{author.email}</strong></a>
    </p>
    <p>I usually respond within 24 hours on business days.</p>
  </section>
  <section>
    <h2>Find me online</h2>
    <p>The accounts I actually use:</p>
    <ul>
      {
        social
          .filter(({ name }) => ['GitHub', 'Twitter', 'Linkedin'].includes(name))
          .map(({ name, url, follow }) => (
            <li>
              <ExternalLink href={url} follow={follow} title={`Find Dawid Ryłko on ${name}`}>
                {name}
              </ExternalLink>
            </li>
          ))
      }
    </ul>
  </section>
</PageLayout>
