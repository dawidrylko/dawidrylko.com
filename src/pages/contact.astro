---
import PageLayout from '../layouts/PageLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE_METADATA } from '../data/site-metadata';
import { STRUCTURED_DATA } from '../data/structured-data';
import { createPageSchema } from '../lib/page-metadata';
import type { PageMetadata } from '../types';

const PAGE_METADATA: PageMetadata = {
  title: 'Contact',
  description:
    'Get in touch with Dawid Ryłko about system architecture, security reviews, full-stack delivery, and technical leadership.',
  keywords: [
    'contact Dawid Ryłko',
    'system architecture consulting',
    'cybersecurity consulting',
    'security review',
    'full-stack development',
    'cloud infrastructure',
    'AI agents',
    'technology collaboration',
  ],
};

const author = SITE_METADATA.author;
const { personReference } = STRUCTURED_DATA;

// Forms of engagement: how a collaboration is shaped, not what it covers, so
// the cards use none of the home page's capability vocabulary.
const ENGAGEMENTS = [
  {
    term: 'One-off review',
    description:
      "A fixed-scope look at a system's architecture and security, ending with a prioritised list of what to fix first.",
  },
  {
    term: 'Ongoing advisory',
    description: 'Regular time for design decisions, second opinions on proposals, and questions about cloud costs.',
  },
  {
    term: 'Embedded in your team',
    description:
      'A longer engagement inside the team, owning the architecture and the review process as the product grows.',
  },
  {
    term: 'Project delivery',
    description: 'A scoped build from first design to production, with AI agents where they replace manual work.',
  },
];

const structuredData = createPageSchema({
  pathname: Astro.url.pathname,
  title: PAGE_METADATA.title,
  description: PAGE_METADATA.description,
  keywords: PAGE_METADATA.keywords,
  extra: { mainEntity: personReference },
});
---

<PageLayout breadcrumbTitle={PAGE_METADATA.title} title={PAGE_METADATA.title} description={PAGE_METADATA.description}>
  <JsonLd data={structuredData} />
  <header>
    <h1>{PAGE_METADATA.title}</h1>
  </header>
  <section>
    <p>
      I take on work where the architecture matters and the system has to keep running long after the launch. A
      greenfield project is fine. So is a platform that has grown past its original design.
    </p>
  </section>
  <section id="engagements">
    <h2>How I can help</h2>
    <ul class="capabilities">
      {ENGAGEMENTS.map(({ term, description }) => (
        <li>
          <strong>{term}</strong>
          {description}
        </li>
      ))}
    </ul>
  </section>
  <section id="first-email">
    <h2>What to put in the first email</h2>
    <ul>
      <li>The problem, in a few sentences.</li>
      <li>What you have already tried, and what happened.</li>
      <li>The scale and the timeline: the team, the deadline, and how much is already running.</li>
    </ul>
    <p>That is enough to start.</p>
  </section>
  <section>
    <h2>How to reach me</h2>
    <p>
      Email is the fastest route:&nbsp;
      <a href={`mailto:${author.email}`} title="Send email">
        <strong>{author.email}</strong>
      </a>
    </p>
    <p>I usually respond within 24 hours on business days.</p>
  </section>
</PageLayout>
