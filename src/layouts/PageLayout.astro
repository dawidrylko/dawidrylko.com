---
// Scope web fonts to the weights/subsets actually used instead of the full
// barrels. Montserrat (headings) ships as one variable font; wght.css carries
// the upright axis only (drops the unused italic file) and the @font-face rules
// are unicode-range scoped, so the browser fetches just the needed subset.
// Merriweather (body) is static, so we import only weights 400/700 for the
// latin + latin-ext (Polish) subsets — dropping the unused 300/900/italic files.
import '@fontsource-variable/montserrat/wght.css';
import '@fontsource/merriweather/latin-400.css';
import '@fontsource/merriweather/latin-700.css';
import '@fontsource/merriweather/latin-ext-400.css';
import '@fontsource/merriweather/latin-ext-700.css';
// woff2 URL for the above-the-fold body font, preloaded in <head> below.
// Importing the asset yields the same hashed URL the @font-face rules resolve
// to, so the preload hits the exact file the CSS requests (no double download).
// Only the body font is preloaded: a single high-priority font preload follows
// best practice and avoids competing with render-critical JS on heavy pages
// (e.g. the Mermaid island on /setup/). Montserrat still loads via its
// unicode-range @font-face from the import above.
import merriweatherBody from '@fontsource/merriweather/files/merriweather-latin-400-normal.woff2';
import '../styles/normalize.css';
import '../styles/main.css';
import Seo from '../components/Seo.astro';
import Menu from '../components/Menu.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Bio from '../components/Bio.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE_METADATA } from '../data/site-metadata';
import { STRUCTURED_DATA } from '../data/structured-data';
import CookieConsent from '../components/CookieConsent.tsx';
import { CONSENT_DEFAULTS } from '../lib/consent-model';
import { consentCopyFor } from '../data/consent-copy';
import { DEFAULT_LANG } from '../lib/i18n';
import type { NavLink } from '../types';

// Port of src/components/layout.tsx — the chrome shared by every page (header
// with menu, main content, breadcrumbs, bio, footer) plus the document <head>.
interface Props {
  breadcrumbTitle: string;
  breadcrumbParents?: NavLink[];
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  article?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  noIndex?: boolean;
  noIndexFollow?: boolean;
  lang?: string;
}

const {
  breadcrumbTitle,
  breadcrumbParents,
  title,
  description,
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  article,
  publishedTime,
  modifiedTime,
  tags,
  noIndex,
  noIndexFollow,
  lang,
} = Astro.props;

const metaLang = lang ?? DEFAULT_LANG;
const pathname = Astro.url.pathname;
const isRootPath = pathname === '/';
const canonical = new URL(pathname, Astro.site).href;
const year = new Date().getFullYear();

// Site-wide identity graph. The real blog query URL is exposed as SearchAction,
// and the canonical Person is emitted once for page/article @id references.
const { website, person } = STRUCTURED_DATA;

// Consent banner and footer control speak the language of the page they sit on.
const consentCopy = consentCopyFor(metaLang);

// Serialised once so the inline defaults and the runtime update share a single
// list of consent types. Leaving a declared type unanswered in the update makes
// gtag.js queue every hit, measurement included.
const consentDefaults = JSON.stringify(CONSENT_DEFAULTS);
---

<!doctype html>
<html lang={metaLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      /* Google Consent Mode v2 defaults. Every signal starts denied except what
        the site itself needs, and gtag.js is not referenced here at all: the
        loader is injected by the consent island only once the visitor agrees,
        so before consent the browser makes no request to Google whatsoever.
        Placed after charset and viewport, neither of which touches dataLayer,
        so the encoding declaration stays well inside the first 1024 bytes. */
    }
    {
      import.meta.env.PROD && (
        <script
          is:inline
          set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('consent','default',${consentDefaults});gtag('set','ads_data_redaction',true);`}
        />
      )
    }
    {
      /* Only `noIndex` suppresses the canonical, and the reason is the URL, not
        the noindex: a 404 would point its canonical at a non-200 URL, which SEO
        audits flag. Pages excluded via `noIndexFollow` are ordinary 200 pages,
        so they keep their self-canonical. */
    }
    {!noIndex && <link rel="canonical" href={canonical} />}
    {
      /* hreflang declares each URL's language to search engines. Every page is
        monolingual (English shell or Polish content) with no translated twin, so
        the page self-references its own language and doubles as x-default. Like
        the canonical, it is skipped on `noIndex` pages so it never points at a
        non-200 URL; `noIndexFollow` pages are real 200 URLs and keep it. */
    }
    {!noIndex && <link rel="alternate" hreflang={metaLang} href={canonical} />}
    {!noIndex && <link rel="alternate" hreflang="x-default" href={canonical} />}
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#005b99" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE_METADATA.title} href="/rss.xml" />
    <link rel="author" href="/humans.txt" />
    {
      /* Preload the above-the-fold body font so the critical text face is
      fetched before CSS is parsed, cutting LCP and swap-driven CLS. */
    }
    <link rel="preload" href={merriweatherBody} as="font" type="font/woff2" crossorigin />
    <Seo
      title={title}
      description={description}
      pathname={pathname}
      image={image}
      imageAlt={imageAlt}
      imageWidth={imageWidth}
      imageHeight={imageHeight}
      article={article}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      tags={tags}
      noIndex={noIndex}
      noIndexFollow={noIndexFollow}
      lang={metaLang}
    />
    <JsonLd data={{ '@context': 'https://schema.org', '@graph': [website, person] }} />

    {
      /* Core Web Vitals → GA4. The module checks consent before reporting, so
        metrics measured before the visitor answers are dropped, not queued. */
    }
    {
      /* Applies an existing decision before the metrics below register, so a
        returning visitor who accepted is measured from the start of the visit. */
    }
    <script>
      import '../scripts/consent-boot';
    </script>
    <script>
      import '../scripts/web-vitals';
    </script>
    {/* Reopens the consent banner from the footer control. */}
    <script>
      import '../scripts/cookie-settings';
    </script>
  </head>
  <body>
    <div class="global-wrapper" data-is-root-path={isRootPath}>
      <header class="header">
        <div class="header-title"><a href="/">{SITE_METADATA.title}</a></div>
        <Menu />
      </header>
      <main><slot /></main>
      <Breadcrumbs customTitle={breadcrumbTitle} parents={breadcrumbParents} />
      <hr />
      <Bio />
      <hr />
      <footer class="footer">
        <div class="footer-copyright">
          Copyright © {year}{' '}
          <a href={SITE_METADATA.url}>{SITE_METADATA.author.name}</a>
        </div>
        <nav class="footer-metadata" aria-label="More pages">
          <a href="/setup/">Setup</a>
          <span class="separator" aria-hidden="true">•</span>
          <a href="/files/">Files</a>
          <span class="separator" aria-hidden="true">•</span>
          <a href="/metadata/">Metadata</a>
          <span class="separator" aria-hidden="true">•</span>
          <a href={consentCopy.privacyPolicy.href}>{consentCopy.privacyPolicy.label}</a>
          <span class="separator" aria-hidden="true">•</span>
          <a href={consentCopy.cookiePolicy.href}>{consentCopy.cookiePolicy.label}</a>
        </nav>
        {
          /* Withdrawing consent has to be as easy as giving it (art. 7(3) GDPR),
            so the way back to the decision lives in the chrome of every page. */
        }
        <div class="footer-consent">
          <button type="button" class="link-button" data-cookie-settings>{consentCopy.settings}</button>
        </div>
      </footer>
      <CookieConsent client:load lang={metaLang} />
    </div>
  </body>
</html>
