---
import RecordTable from './RecordTable.astro';
import { abstractHtml, publicationLinks, STATUS_LABELS, type Publication } from '../lib/publications';
import type { RecordDetail, RecordRow } from '../lib/record-table';

interface Props {
  caption: string;
  publications: Publication[];
}

const { caption, publications } = Astro.props;

const citation = ({ authors, venue, doi }: Publication): string =>
  [authors.map(({ name }) => name).join(', ') + '.', venue && `${venue}.`, doi && `DOI: ${doi}`]
    .filter(Boolean)
    .join(' ');

const details = ({ abstract, keywords, license }: Publication): RecordDetail[] => [
  ...(abstract ? [{ html: abstractHtml(abstract) }] : []),
  ...(keywords ? [{ label: 'Keywords', text: keywords.join(', ') }] : []),
  ...(license ? [{ label: 'License', text: license.name }] : []),
];

const rows: RecordRow[] = publications.map(publication => ({
  id: publication.id,
  cells: [
    { text: publication.title, secondary: citation(publication) },
    { text: String(publication.year), datetime: publication.date ?? String(publication.year) },
    STATUS_LABELS[publication.status],
  ],
  links: publicationLinks(publication),
  details: details(publication),
}));
---

<RecordTable
  caption={caption}
  columns={[
    { label: 'Title', wrap: true, primary: true },
    { label: 'Year', width: 'w-10' },
    { label: 'Status', width: 'w-15' },
  ]}
  rows={rows}
/>
