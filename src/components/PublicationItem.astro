---
import ExternalLink from './ExternalLink.astro';
import { abstractHtml, doiUrl, publicationLandingUrl, STATUS_LABELS, type Publication } from '../lib/publications';

interface Props {
  publication: Publication;
}

const { publication } = Astro.props;
const { id, title, authors, year, date, venue, doi, abstract, keywords, pdfUrl, codeUrl, license, status } =
  publication;
const landingUrl = publicationLandingUrl(publication);
const authorNames = authors.map(({ name }) => name).join(', ');
---

<article class="publication" id={id}>
  <h3>
    {landingUrl ? (
      <ExternalLink href={landingUrl} follow>
        {title}
      </ExternalLink>
    ) : (
      title
    )}
  </h3>
  <p class="publication-citation">
    {authorNames}. <time datetime={date ?? String(year)}>{year}</time>.{venue && ` ${venue}.`}{' '}
    <span class="publication-status">{STATUS_LABELS[status]}</span>
  </p>
  <dl class="publication-meta">
    {doi && (
      <div>
        <dt>DOI</dt>
        <dd>
          <ExternalLink href={doiUrl(doi)} follow>
            {doi}
          </ExternalLink>
        </dd>
      </div>
    )}
    {pdfUrl && (
      <div>
        <dt>Full text</dt>
        <dd>
          <ExternalLink href={pdfUrl} follow>
            PDF
          </ExternalLink>
        </dd>
      </div>
    )}
    {codeUrl && (
      <div>
        <dt>Source code</dt>
        <dd>
          <ExternalLink href={codeUrl} follow>
            Repository at this release
          </ExternalLink>
        </dd>
      </div>
    )}
    {keywords && (
      <div>
        <dt>Keywords</dt>
        <dd>{keywords.join(', ')}</dd>
      </div>
    )}
    {license && (
      <div>
        <dt>License</dt>
        <dd>
          <ExternalLink href={license.url}>{license.name}</ExternalLink>
        </dd>
      </div>
    )}
  </dl>
  {abstract && (
    <details class="publication-abstract">
      <summary>Abstract</summary>
      <p set:html={abstractHtml(abstract)} />
    </details>
  )}
</article>
