---
import ExternalLink from './ExternalLink.astro';
import { OEIS_ROLE_LABELS, oeisAnchor, oeisUrl, type OeisEntry } from '../lib/oeis';

interface Props {
  caption: string;
  entries: OeisEntry[];
}

const { caption, entries } = Astro.props;
---

<div class="table-scroll" tabindex="0" role="region" aria-label={caption}>
  <table class="publications-table">
    <caption class="visually-hidden">{caption}</caption>
    <colgroup>
      <col class="col-w-15" />
      <col />
      <col class="col-w-15" />
    </colgroup>
    <thead>
      <tr>
        <th scope="col">Sequence</th>
        <th scope="col">Name</th>
        <th scope="col">Role</th>
      </tr>
    </thead>
    <tbody>
      {entries.map(({ id, name, role, contribution, date }) => (
        <tr id={oeisAnchor(id)}>
          <td>
            <ExternalLink href={oeisUrl(id)} follow>
              {id}
            </ExternalLink>
          </td>
          <td class="publication-cell">
            {name}
            {contribution && <p class="publication-citation">Contributed: {contribution.join('; ')}.</p>}
          </td>
          <td>
            {OEIS_ROLE_LABELS[role]}
            {date && (
              <>
                <br />
                <time datetime={date}>{date}</time>
              </>
            )}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
