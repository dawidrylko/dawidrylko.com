---
import RecordTable from './RecordTable.astro';
import { OEIS_ROLE_LABELS, oeisAnchor, oeisUrl, type OeisEntry } from '../lib/oeis';
import type { RecordRow } from '../lib/record-table';

interface Props {
  caption: string;
  entries: OeisEntry[];
}

const { caption, entries } = Astro.props;

const rows: RecordRow[] = entries.map(({ id, name, role, contribution, date }) => ({
  id: oeisAnchor(id),
  cells: [id, name, OEIS_ROLE_LABELS[role], date ? { text: date, datetime: date } : '—'],
  links: [
    {
      kind: 'external',
      href: oeisUrl(id),
      label: `Open ${id} on oeis.org`,
      follow: true,
    },
  ],
  details: contribution ? [{ label: 'Contributed', text: `${contribution.join('; ')}.` }] : undefined,
}));
---

<RecordTable
  caption={caption}
  columns={[
    { label: 'Sequence', width: 'w-10', primary: true },
    { label: 'Name', wrap: true },
    { label: 'Role', width: 'w-10' },
    { label: 'Submitted', width: 'w-15' },
  ]}
  rows={rows}
/>
